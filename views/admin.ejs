<%- include('layout') %>
  <h1>Users</h1>
  <table>
    <tr>
      <th>#</th>
      <th>Username</th>
      <th>Name</th>
      <th>Role</th>
    </tr>
    <% users.forEach(function(u){ %>
      <tr>
        <td>
          <%= u.id %>
        </td>
        <td>
          <%= u.username %>
        </td>
        <td>
          <%= u.name %>
        </td>
        <td>
          <%= u.role %>
        </td>
      </tr>
      <% }); %>
  </table>
  </body>

  </html>